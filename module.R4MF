# R4OS 0.55.20 security protocol project manifest.
R4OS_MODULE_MANIFEST=2
KIND=R4P
NAME=R4AUTH
VERSION=0.1.1
LANGUAGE=Zig
SOURCE=src/main.zig
TARGET=/R4OS/PROTOCOLS/R4AUTH.R4P
IMAGE_SCOPE=slim
IMPORT=R4DEV:Query:1
META=r4p.name=R4AUTH
META=r4p.role=security.credssp
META=r4p.category=data
META=module.name=R4P_R4AUTH
META=r4p.dep=security.tls
META=description=Reusable CredSSP authentication protocol foundation
META=feature=credssp-tsrequest-probe
META=feature=credssp-tsrequest-parser-builder
META=feature=spnego-neg-token-contract
META=feature=ntlmv2-fixed-profile
META=feature=credssp-state-machine
META=feature=credssp-pubkeyauth-contract
META=feature=credssp-windows-variants
META=feature=credssp-windows-pubkeyauth-binding
META=feature=credssp-live-r4lk-state
META=dependency=security.tls
META=consumer=RDPSVC
